# ─────────────────────────────────────────────────────────────────────────────
# The Launch Feed — environment template — copy to .env.local.
# Every variable below is read somewhere in the code. Values already filled in
# work for local testing; fill the empty ones with your own keys.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
# Neon Postgres URL
# (with ?sslmode=require).
DATABASE_URL=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Session signing secret (openssl rand -hex 32)
APP_SECRET=""
# Encrypts stored revenue-provider API keys (openssl rand -base64 32)
TOKEN_ENCRYPTION_KEY=""
# Email that gets the ADMIN role and access to /admin
ADMIN_EMAIL=""

# ── Auth (Neon Auth / Better Auth) ───────────────────────────────────────────
NEON_AUTH_URL=""
NEXT_PUBLIC_NEON_AUTH_URL=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ── Background jobs (lib/jobs — replaces Inngest) ────────────────────────────
# Bearer token for /api/cron heartbeats (Vercel Cron, Cloudflare Worker, GitHub Actions)
CRON_SECRET=""
# "true" = run the 60s in-process scheduler during `npm run dev`
# (publishes due launches, leaderboard, badge audit…). Off by default in dev.
JOBS_INPROCESS=""
# "true" = pause all scheduled work
JOBS_DISABLED=""

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="The Launch Feed <hi@thelaunchfeed.com>"

# ── Payments (Dodo) — $5 / $10 launch tiers ──────────────────────────────────
DODO_PAYMENTS_API_KEY=""
# "test_mode" locally, "live_mode" in production
DODO_PAYMENTS_ENV="test_mode"
DODO_PAYMENTS_WEBHOOK_SECRET=""
# Legacy name still accepted as a fallback for the webhook secret
DODO_WEBHOOK_SECRET=""
DODO_PRODUCT_ID_5=""
DODO_PRODUCT_ID_10=""

# ── Storage (Neon Object Storage / S3) — logos & screenshots ─────────────────
AWS_ENDPOINT_URL_S3=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-2"
AWS_S3_BUCKET_NAME="thelaunchfeed"
NEXT_PUBLIC_STORAGE_BUCKET_URL=""

# ── Search indexing ──────────────────────────────────────────────────────────
# Google Indexing API key used by lib/indexing
WEB_INDEXING_API_KEY=""
# IndexNow key (≥ 8 chars); must match public/<key>.txt
INDEXNOW_KEY=""

# ── AI autofill & GitHub ─────────────────────────────────────────────────────
OPENAI_API_KEY=""
# Optional: raises GitHub API rate limit for autofill (60/hr → 5000/hr)
GITHUB_TOKEN=""
