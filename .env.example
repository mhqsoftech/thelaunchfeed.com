# Direct Neon PostgreSQL connection URL (e.g. from Neon Console → Connection Details)
# Must include ?sslmode=verify-full parameter
DATABASE_URL=""

# Neon Auth (Better Auth) — magic link + Google + GitHub
# Enable in Neon Console → Auth tab. Copy both URLs verbatim from the "Project
# Info" panel there. Providers can be configured in the Console or via .env below.
# Users auto-sync into the neon_auth.users_sync table.
NEON_AUTH_URL=""
NEON_AUTH_JWKS_URL=""
# Same value as NEON_AUTH_URL — exposed to the browser so better-auth's
# React client can call it directly.
NEXT_PUBLIC_NEON_AUTH_URL=""

# OAuth Social Providers (for direct Next.js / Better Auth or fallback)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Encryption — generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=""
APP_SECRET=""

# Redis
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Our payments
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Revenue providers
STRIPE_CONNECT_CLIENT_ID=""
POLAR_CLIENT_ID=""
POLAR_CLIENT_SECRET=""
LEMONSQUEEZY_CLIENT_ID=""
LEMONSQUEEZY_CLIENT_SECRET=""
REVENUECAT_CLIENT_ID=""
REVENUECAT_CLIENT_SECRET=""

# Inngest — automation, cron, email fanout
# In dev: run `npx inngest-cli dev` alongside `npm run dev` (keys optional).
# In prod: create an Inngest app, copy both keys, set INNGEST_SERVE_HOST
# to your deployed URL for signature verification.
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""
CRON_SECRET=""

# Admin — email of the user allowed to access /admin
ADMIN_EMAIL=""

# Misc
# Resend for outbound transactional email (used by the Inngest email fanout).
# EMAIL_FROM must be a verified sender in your Resend project.
RESEND_API_KEY=""
EMAIL_FROM="The Launch Feed <hi@thelaunchfeed.com>"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# AI Autofill
OPENAI_API_KEY=""
# Optional GitHub token to raise API rate limit (60/hr -> 5000/hr)
GITHUB_TOKEN=""

# Neon Object Storage / S3
AWS_ENDPOINT_URL_S3=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-2"
AWS_S3_BUCKET_NAME="thelaunchfeed"
NEXT_PUBLIC_STORAGE_BUCKET_URL=""
